[
	{
		"dt": "Sales Invoice",
		"fieldname": "zra_section",
		"fieldtype": "Section Break",
		"label": "ZRA",
		"insert_after": "amended_from",
		"collapsible": 1
	},
	{
		"dt": "Sales Invoice",
		"fieldname": "is_non_taxable",
		"fieldtype": "Check",
		"label": "Is Non Taxable",
		"insert_after": "zra_section",
		"default": "0",
		"description": "If checked, this invoice will not be sent to ZRA."
	},
	{
		"dt": "Sales Invoice",
		"fieldname": "tax_status",
		"fieldtype": "Select",
		"label": "Tax Status",
		"insert_after": "is_non_taxable",
		"options": "\nNot Sent\nPending\nSuccess\nFailed",
		"default": "Not Sent",
		"no_copy": 1,
		"read_only": 1,
		"in_list_view": 0,
		"in_standard_filter": 1
	},
	{
		"dt": "Sales Invoice",
		"fieldname": "zra_col_break",
		"fieldtype": "Column Break",
		"insert_after": "tax_status"
	},
	{
		"dt": "Sales Invoice",
		"fieldname": "relief_number",
		"fieldtype": "Data",
		"label": "Relief Number",
		"insert_after": "zra_col_break",
		"description": "Special relief number issued by ZRB. Fill this to use the Relief Sales endpoint."
	},
	{
		"dt": "Sales Invoice",
		"fieldname": "relief_id",
		"fieldtype": "Data",
		"label": "Relief ID",
		"insert_after": "relief_number",
		"read_only": 1
	},
	{
		"dt": "Sales Invoice",
		"fieldname": "verify_relief_number",
		"fieldtype": "Button",
		"label": "Verify Relief Number",
		"insert_after": "relief_id",
		"depends_on": "eval:doc.relief_number && !doc.relief_id"
	},
	{
		"dt": "Sales Invoice",
		"fieldname": "send_tax",
		"fieldtype": "Button",
		"label": "Send Tax",
		"insert_after": "verify_relief_number",
		"depends_on": "eval:doc.tax_status != 'Success' && !doc.is_non_taxable && doc.docstatus == 1"
	}
]
